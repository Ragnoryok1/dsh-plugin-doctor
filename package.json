{
  "name": "@ragnoryok1/dsh-plugin-doctor",
  "description": "Diagnostics for DeepSeek Harness: finds plugins that failed to load, bundles whose rows never started, version mismatches and unmanageable entries, and explains what to do",
  "version": "0.1.2",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "cordis",
    "cordis-plugin",
    "diagnostics",
    "doctor",
    "troubleshooting"
  ],
  "license": "MIT",
  "author": "Ragnoryok1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ragnoryok1/dsh-plugin-doctor.git"
  },
  "homepage": "https://github.com/Ragnoryok1/dsh-plugin-doctor#readme",
  "bugs": {
    "url": "https://github.com/Ragnoryok1/dsh-plugin-doctor/issues"
  },
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "images/"
  ],
  "bin": {
    "dsh-doctor": "./bin/doctor-scan.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "check:readmes": "node scripts/check-readmes.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.2 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "react": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.2 <0.2.0-0 || >=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.3.0-0",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
